        ttk.Label(settings_card, text="Tune the inventory view for your workspace. Changes apply immediately.", style="Sub.TLabel").pack(anchor="w", pady=(4, 20))

        ttk.Label(settings_card, text="Appearance", style="PreferenceTitle.TLabel").pack(anchor="w")
        ttk.Label(settings_card, text="Choose a light or dark SOC workspace.", style="PreferenceText.TLabel").pack(anchor="w", pady=(3, 8))
        theme_row = ttk.Frame(settings_card, style="Card.TFrame")
