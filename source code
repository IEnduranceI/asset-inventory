    def export_inventory(self):
        current = self.active_inventory_file
        chosen = filedialog.asksaveasfilename(parent=self, title="Export inventory", defaultextension=".json", filetypes=[("Asset Inventory JSON", "*.json")], initialdir=str(current.parent) if current else str(Path.home()), initialfile=current.name if current else "asset-inventory.json")
        if not chosen:
            return
        path = Path(chosen)
        try:
            self.db.export_file(path)
            self.active_inventory_file = path
            self._remember_active_file()
            self.clear_filters()
            self.refresh()
            messagebox.showinfo("Export complete", f"Inventory saved to:\\n{path}", parent=self)
        except OSError as exc:
            messagebox.showerror("Export failed", str(exc), parent=self)

    def import_inventory(self):
        current = self.active_inventory_file
        chosen = filedialog.askopenfilename(parent=self, title="Import inventory", filetypes=[("Asset Inventory JSON", "*.json"), ("All files", "*.*")], initialdir=str(current.parent) if current else str(Path.home()), initialfile=current.name if current else "")
        if not chosen:
            return
        path = Path(chosen)
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(data, dict) or data.get("format") != "asset-inventory" or not isinstance(data.get("devices"), list):
                raise ValueError("This file is not a supported Asset Inventory file.")
            count = len(data["devices"])
            if not messagebox.askyesno("Replace current inventory?", f"Import {count} devices and replace the current inventory? This cannot be undone.", parent=self):
                return
            self.db.import_file(path)
            self.active_inventory_file = path
            self._remember_active_file()
            self.clear_filters()
            self.refresh()
            messagebox.showinfo("Import complete", f"Imported {count} devices from:\\n{path}", parent=self)
        except (OSError, json.JSONDecodeError, ValueError, sqlite3.Error) as exc:
            messagebox.showerror("Import failed", str(exc), parent=self)
    def open_connection_tree(self):
        existing = getattr(self, "connection_tree_window", None)
        if existing and existing.winfo_exists():
            existing.deiconify()
            existing.lift()
            return
        self.connection_tree_window = ConnectionTreeWindow(self, self.db)

    def manage_connections(self):
        OptionManagerDialog(self, self.db, "connection", self.persist_active_file)
    def show_section(self, section):
        self.section.set(section)
        for name, button in getattr(self, "nav_buttons", {}).items():
            button.configure(style="NavActive.TButton" if name == section else "Nav.TButton")
        self.home_panel.pack_forget()
        self.overview_panel.pack_forget()
        self.preferences_panel.pack_forget()
        if section == "overview":
            self.overview_panel.pack(fill="both", expand=True)
            self.refresh_overview()
        elif section == "preferences":
            self.preferences_panel.pack(fill="both", expand=True)
        else:
            self.home_panel.pack(fill="both", expand=True)

    def add_device(self):
        dlg = DeviceDialog(self, self.db)
        self.wait_window(dlg)
        if dlg.result:
            self.clear_filters()
            self.refresh()
            self.persist_active_file()
            device_iid = str(dlg.device_id)
            self.tree.selection_set(device_iid)
            self.tree.focus(device_iid)
            self.tree.see(device_iid)

    def _selected_record(self):
        chosen = self.tree.selection()
        return int(chosen[0]) if chosen else None

    def edit_selected(self):
        device_id = self._selected_record()
        if device_id is None:
            messagebox.showinfo("Select a device", "Select a device row first.", parent=self)
            return
        record = self.db.conn.execute("SELECT * FROM devices WHERE id=?", (device_id,)).fetchone()
        dlg = DeviceDialog(self, self.db, record)
        dlg.device_id = device_id
        self.wait_window(dlg)
        if dlg.result:
            self.clear_filters()
            self.refresh()
            self.persist_active_file()
            self.tree.selection_set(str(device_id))
            self.tree.focus(str(device_id))
            self.tree.see(str(device_id))

    def delete_selected(self):
        device_id = self._selected_record()
        if device_id is None:
            messagebox.showinfo("Select a device", "Select a device row first.", parent=self)
            return
        if messagebox.askyesno("Delete device", "Delete this device from the inventory? This cannot be undone.", parent=self):
            self.db.delete(device_id)
            self.refresh()
            self.persist_active_file()

    def on_select(self, _event=None):
        self.selected_id = self._selected_record()

    def filters(self):
        return {key: var.get().strip() for key, var in self.filter_vars.items()}

    def clear_filters(self):
        for var in self.filter_vars.values():
            var.set("")
        self.refresh()

    def refresh(self):
        rows = self.db.rows(self.filters())
        self.tree.delete(*self.tree.get_children())
        max_ip_length = max((len(format_ip_address(row["ip_address"])) for row in rows), default=0)
        self.tree.column("ip_address", width=max(150, min(360, max_ip_length * 9 + 28)))
        for row in rows:
            values = [format_ip_address(row["ip_address"]) if column[0] == "ip_address" else row[column[0]] for column in self.COLUMNS]
            self.tree.insert("", "end", iid=str(row["id"]), values=values)
        total = self.db.conn.execute("SELECT COUNT(*) FROM devices").fetchone()[0]
        self.stats.configure(text=f"{total} device{'s' if total != 1 else ''} in inventory")
        self.status.configure(text=f"Showing {len(rows)} of {total} devices  ·  Filters combine to narrow results")
        self.refresh_overview()

    def refresh_overview(self):
        if not hasattr(self, "overview_count_vars"):
            return
        host_count = self.db.conn.execute("SELECT COUNT(*) FROM devices").fetchone()[0]
        link_count = self.db.conn.execute("SELECT COUNT(*) FROM device_links l JOIN devices a ON a.id=l.source_id JOIN devices b ON b.id=l.target_id").fetchone()[0]
        type_count = self.db.conn.execute("SELECT COUNT(DISTINCT COALESCE(NULLIF(TRIM(device_type), ''), 'Unspecified')) FROM devices").fetchone()[0]
        organization_count = self.db.conn.execute("SELECT COUNT(DISTINCT COALESCE(NULLIF(TRIM(organization), ''), 'Unassigned')) FROM devices").fetchone()[0]
        self.overview_count_vars["hosts"].set(str(host_count))
        self.overview_count_vars["links"].set(str(link_count))
        self.overview_count_vars["types"].set(str(type_count))
        self.overview_count_vars["organizations"].set(str(organization_count))
        self.type_summary.delete(*self.type_summary.get_children())
        for row in self.db.conn.execute("SELECT COALESCE(NULLIF(TRIM(device_type), ''), 'Unspecified') AS label, COUNT(*) AS total FROM devices GROUP BY label ORDER BY label COLLATE NOCASE"):
            self.type_summary.insert("", "end", values=(row["label"], row["total"]))
        self.connection_summary.delete(*self.connection_summary.get_children())
        for row in self.db.conn.execute("SELECT COALESCE(NULLIF(TRIM(connection), ''), 'Unspecified') AS label, COUNT(*) AS total FROM devices GROUP BY label ORDER BY label COLLATE NOCASE"):
            self.connection_summary.insert("", "end", values=(row["label"], row["total"]))

        device_counts = {}
        organization_names = {}
        connection_counts = {}
        for row in self.db.conn.execute("SELECT COALESCE(NULLIF(TRIM(organization), ''), 'Unassigned') AS label, COUNT(*) AS total FROM devices GROUP BY label ORDER BY label COLLATE NOCASE"):
            key = row["label"].casefold()
            organization_names[key] = row["label"]
            device_counts[key] = row["total"]
            connection_counts[key] = 0
        for row in self.db.conn.execute("SELECT a.organization AS source_org, b.organization AS target_org FROM device_links l JOIN devices a ON a.id=l.source_id JOIN devices b ON b.id=l.target_id"):
            source = (row["source_org"] or "").strip() or "Unassigned"
            target = (row["target_org"] or "").strip() or "Unassigned"
            source_key, target_key = source.casefold(), target.casefold()
            organization_names.setdefault(source_key, source)
            organization_names.setdefault(target_key, target)
            for key in {source_key, target_key}:
                connection_counts[key] = connection_counts.get(key, 0) + 1
        self.overview_organization_summary.delete(*self.overview_organization_summary.get_children())
        for key in sorted(organization_names, key=lambda item: organization_names[item].casefold()):
            self.overview_organization_summary.insert("", "end", values=(
                organization_names[key], device_counts.get(key, 0), connection_counts.get(key, 0)
            ))
    def sort_by(self, key):
        items = [(self.tree.set(i, key).casefold(), i) for i in self.tree.get_children("")]
        reverse = getattr(self, "_sort_reverse", {}).get(key, False)
        items.sort(reverse=reverse)
        for index, (_, iid) in enumerate(items):
            self.tree.move(iid, "", index)
        self._sort_reverse = getattr(self, "_sort_reverse", {})
        self._sort_reverse[key] = not reverse


