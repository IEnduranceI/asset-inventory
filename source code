"""Asset Inventory — a local desktop app for tracking networked devices.

Run with: python main.py
Inventory stays in memory until the user imports or exports a chosen JSON file.
"""
from __future__ import annotations

import ipaddress
import json
import sqlite3
import sys
import tkinter as tk
from tkinter import filedialog, messagebox, ttk
from pathlib import Path


def resource_path(filename: str) -> Path:
    base = Path(getattr(sys, "_MEIPASS", Path(__file__).resolve().parent))
    return base / filename


def apply_app_icon(window) -> None:
    """Apply the bundled Asset Inventory icon to this top-level window."""
    try:
        window.iconbitmap(str(resource_path("asset_inventory.ico")))
    except (tk.TclError, OSError):
        pass

def format_ip_address(value: str) -> str:
    try:
        return ipaddress.ip_address(value.strip()).compressed
    except ValueError:
        return value

SCHEMA = """
CREATE TABLE IF NOT EXISTS devices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ip_address TEXT NOT NULL,
    device_type TEXT NOT NULL DEFAULT '',
    hostname TEXT NOT NULL DEFAULT '',
    organization TEXT NOT NULL DEFAULT '',
    connection TEXT NOT NULL DEFAULT 'Internal',
    user_type TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS device_links (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    source_id INTEGER NOT NULL REFERENCES devices(id) ON DELETE CASCADE,
    target_id INTEGER NOT NULL REFERENCES devices(id) ON DELETE CASCADE,
    label TEXT NOT NULL DEFAULT 'Connected',
    UNIQUE(source_id, target_id, label)
);
CREATE TABLE IF NOT EXISTS settings (
    category TEXT NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY (category, value)
);
"""
DEFAULTS = {
    "connection": ["Internal", "External"],
    "device_type": ["Desktop", "Laptop", "Server", "Printer", "Router", "Switch", "Phone", "Other"],
    "user_type": ["Admin", "Employee", "Service account", "Shared", "Unknown"],
}


class InventoryDB:
    def __init__(self):
        self.conn = sqlite3.connect(":memory:")
        self.conn.execute("PRAGMA foreign_keys = ON")
        self.conn.row_factory = sqlite3.Row
        self.conn.executescript(SCHEMA)
        self.conn.execute("DELETE FROM device_links WHERE source_id NOT IN (SELECT id FROM devices) OR target_id NOT IN (SELECT id FROM devices)")
        for category, values in DEFAULTS.items():
            self.conn.executemany("INSERT OR IGNORE INTO settings(category,value) VALUES (?,?)",
                                  [(category, value) for value in values])
        self.conn.commit()

    def choices(self, category: str) -> list[str]:
        return [r[0] for r in self.conn.execute(
            "SELECT value FROM settings WHERE category=? ORDER BY value COLLATE NOCASE", (category,))]

    def add_choice(self, category: str, value: str) -> None:
        self.conn.execute("INSERT OR IGNORE INTO settings(category,value) VALUES (?,?)", (category, value.strip()))
        self.conn.commit()

    def save(self, values: dict, device_id: int | None = None) -> None:
        fields = ("ip_address", "device_type", "hostname", "organization", "connection", "user_type", "notes")
        data = [values.get(k, "").strip() for k in fields]
        if device_id is None:
            cursor = self.conn.execute(f"INSERT INTO devices ({','.join(fields)}) VALUES ({','.join('?' for _ in fields)})", data)
            device_id = cursor.lastrowid
        else:
            self.conn.execute(f"UPDATE devices SET {','.join(k+'=?' for k in fields)}, updated_at=CURRENT_TIMESTAMP WHERE id=?", data + [device_id])
        self.conn.commit()
        return device_id

    def delete(self, device_id: int) -> None:
        self.conn.execute("DELETE FROM devices WHERE id=?", (device_id,))
        self.conn.commit()

    def rows(self, filters: dict) -> list[sqlite3.Row]:
        sql = "SELECT * FROM devices WHERE 1=1"
        args: list[str] = []
        for field, value in filters.items():
            if value:
                sql += f" AND {field} LIKE ? COLLATE NOCASE"
                args.append(f"%{value.strip()}%")
        sql += " ORDER BY organization COLLATE NOCASE, ip_address COLLATE NOCASE"
        return list(self.conn.execute(sql, args))


    def export_file(self, path: Path) -> None:
        data = {
            "format": "asset-inventory",
            "version": 1,
            "devices": [dict(row) for row in self.conn.execute("SELECT ip_address, device_type, hostname, organization, connection, user_type, notes FROM devices ORDER BY id")],
            "categories": {category: self.choices(category) for category in DEFAULTS},
            "links": [dict(row) for row in self.conn.execute("SELECT a.ip_address AS source_ip, b.ip_address AS target_ip, l.label FROM device_links l JOIN devices a ON a.id=l.source_id JOIN devices b ON b.id=l.target_id ORDER BY l.id")],
        }
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

    def import_file(self, path: Path) -> int:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or data.get("format") != "asset-inventory" or not isinstance(data.get("devices"), list):
            raise ValueError("This file is not a supported Asset Inventory file.")
        fields = ("ip_address", "device_type", "hostname", "organization", "connection", "user_type", "notes")
        for index, row in enumerate(data["devices"], 1):
            if not isinstance(row, dict) or not str(row.get("ip_address", "")).strip():
                raise ValueError(f"Device {index} must include an IP address.")
            try:
                ipaddress.ip_address(str(row["ip_address"]).strip())
            except ValueError as exc:
                raise ValueError(f"Device {index} has an invalid IP address. Use a valid IP address.") from exc
        with self.conn:
            self.conn.execute("DELETE FROM device_links")
            self.conn.execute("DELETE FROM devices")
            self.conn.executemany(
                "INSERT INTO devices (" + ",".join(fields) + ") VALUES (" + ",".join("?" for _ in fields) + ")",
                [[str(row.get(field, "")).strip() for field in fields] for row in data["devices"]],
            )
            for link in data.get("links", []):
                if not isinstance(link, dict):
                    continue
                source = self.conn.execute("SELECT id FROM devices WHERE ip_address=? ORDER BY id LIMIT 1", (str(link.get("source_ip", "")),)).fetchone()
                target = self.conn.execute("SELECT id FROM devices WHERE ip_address=? ORDER BY id LIMIT 1", (str(link.get("target_ip", "")),)).fetchone()
                if source and target and source["id"] != target["id"]:
                    self.conn.execute("INSERT OR IGNORE INTO device_links(source_id,target_id,label) VALUES (?,?,?)", (source["id"], target["id"], str(link.get("label", "Connected"))))
            categories = data.get("categories", {})
            if isinstance(categories, dict):
                for category in DEFAULTS:
                    values = categories.get(category, [])
                    if isinstance(values, list):
                        self.conn.execute("DELETE FROM settings WHERE category=?", (category,))
                        self.conn.executemany("INSERT OR IGNORE INTO settings(category,value) VALUES (?,?)", [(category, str(value).strip()) for value in values if str(value).strip()])
        return len(data["devices"])
class OptionManagerDialog(tk.Toplevel):
    """Add, remove, and restore selectable values for a device field."""
    def __init__(self, parent, db: InventoryDB, category: str, on_change=None):
        super().__init__(parent)
        apply_app_icon(self)
        self.db = db
        self.category = category
        self.on_change = on_change or (lambda: None)
        self.title(f"Manage {category.replace('_', ' ')} options")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        box = ttk.Frame(self, padding=18)
        box.pack(fill="both", expand=True)
        ttk.Label(box, text=f"Manage {category.replace('_', ' ').title()} Options", style="Title.TLabel").pack(anchor="w")
        self.listing = tk.Listbox(box, height=8, width=38, font=("Segoe UI", 10), exportselection=False)
        self.listing.pack(fill="x", pady=(10, 8))
        add_row = ttk.Frame(box)
        add_row.pack(fill="x")
        self.value = tk.StringVar()
        entry = ttk.Entry(add_row, textvariable=self.value)
        entry.pack(side="left", fill="x", expand=True)
        entry.bind("<Return>", lambda _event: self.add_option())
        ttk.Button(add_row, text="Add", style="Accent.TButton", command=self.add_option).pack(side="left", padx=(8, 0))
        controls = ttk.Frame(box)
        controls.pack(fill="x", pady=(8, 0))
        ttk.Button(controls, text="Delete selected", command=self.remove_option).pack(side="left")
        ttk.Button(controls, text="Restore defaults", command=self.restore_defaults).pack(side="right")
        self.reload_list()

    def reload_list(self):
        self.listing.delete(0, "end")
        for item in self.db.choices(self.category):
            self.listing.insert("end", item)

    def changed(self):
        self.db.conn.commit()
        self.reload_list()
        self.on_change()

    def add_option(self):
        name = self.value.get().strip()
        if not name:
            return
        if any(item.casefold() == name.casefold() for item in self.db.choices(self.category)):
            messagebox.showinfo("Option already exists", "That option is already in the list.", parent=self)
            return
        self.db.add_choice(self.category, name)
        self.value.set("")
        self.changed()

    def remove_option(self):
        selection = self.listing.curselection()
        if not selection:
            return
        name = self.listing.get(selection[0])
        self.db.conn.execute("DELETE FROM settings WHERE category=? AND value=?", (self.category, name))
        self.changed()

    def restore_defaults(self):
        defaults = DEFAULTS.get(self.category, [])
        self.db.conn.execute("DELETE FROM settings WHERE category=?", (self.category,))
        self.db.conn.executemany("INSERT INTO settings(category,value) VALUES (?,?)", [(self.category, value) for value in defaults])
        self.changed()


class DeviceDialog(tk.Toplevel):
    def __init__(self, parent, db: InventoryDB, record=None):
        super().__init__(parent)
        apply_app_icon(self)
        self.db = db
        self.result = None
        self.title("Edit device" if record else "Add device")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        self.configure(bg=getattr(parent, "colors", {}).get("window", "#edf2fa"))
        self.vars = {k: tk.StringVar(value=(record[k] if record else "")) for k in
                     ("ip_address", "device_type", "hostname", "organization", "connection", "user_type")}
        self.vars["connection"].set(record["connection"] if record else "Internal")
        panel = ttk.Frame(self, padding=20)
        panel.grid(sticky="nsew")
        ttk.Label(panel, text="Device details", style="Title.TLabel").grid(row=0, column=0, columnspan=3, sticky="w", pady=(0, 14))
        fields = [("IP address *", "ip_address", None), ("Device type", "device_type", "device_type"),
                  ("Preferred hostname", "hostname", None), ("Organization", "organization", None),
                  ("Connection", "connection", "connection"), ("User type", "user_type", "user_type")]
        for i, (label, key, category) in enumerate(fields, 1):
            ttk.Label(panel, text=label).grid(row=i, column=0, sticky="w", padx=(0, 12), pady=6)
            if category:
                cb = ttk.Combobox(panel, textvariable=self.vars[key], values=db.choices(category), width=30)
                cb.grid(row=i, column=1, sticky="ew", pady=6)
                if key in ("device_type", "user_type", "connection"):
                    ttk.Button(panel, text="Manage", command=lambda c=category, combo=cb: self.manage_options(c, combo)).grid(row=i, column=2, padx=(6, 0))
            else:
                ttk.Entry(panel, textvariable=self.vars[key], width=34).grid(row=i, column=1, columnspan=2, sticky="ew", pady=6)
        ttk.Label(panel, text="Notes").grid(row=7, column=0, sticky="nw", padx=(0, 12), pady=6)
        self.notes = tk.Text(panel, width=36, height=4, wrap="word", font=("Segoe UI", 9), relief="solid", bd=1)
        self.notes.grid(row=7, column=1, columnspan=2, sticky="ew", pady=6)
        if record:
            self.notes.insert("1.0", record["notes"])
        buttons = ttk.Frame(panel)
        buttons.grid(row=8, column=0, columnspan=3, sticky="e", pady=(14, 0))
        ttk.Button(buttons, text="Cancel", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Save device", style="Accent.TButton", command=self.save).pack(side="right")
        self.bind("<Return>", lambda _e: self.save())
        self.bind("<Escape>", lambda _e: self.destroy())
        self.wait_visibility()
        self.focus_set()

    def manage_options(self, category, combo):
        def refresh_options():
            combo.configure(values=self.db.choices(category))
            self.master.persist_active_file()
        OptionManagerDialog(self, self.db, category, refresh_options)

    def save(self):
        values = {k: v.get().strip() for k, v in self.vars.items()}
        values["notes"] = self.notes.get("1.0", "end-1c").strip()
        if not values["ip_address"]:
            messagebox.showerror("Required field", "Enter an IPv4 or IPv6 address.", parent=self)
            return
        try:
            ipaddress.ip_address(values["ip_address"])
        except ValueError:
            messagebox.showerror("Invalid IP address", "Enter a valid IP address.", parent=self)
            return
        existing = self.db.conn.execute(
            "SELECT id FROM devices WHERE lower(trim(ip_address))=lower(trim(?)) AND lower(trim(organization))=lower(trim(?)) AND id<>? LIMIT 1",
            (values["ip_address"], values["organization"], getattr(self, "device_id", -1)),
        ).fetchone()
        if existing and not messagebox.askyesno(
            "Possible duplicate device",
            "This organization already has a device with this IP address. Add another entry anyway?",
            parent=self,
        ):
            return
        try:
            self.device_id = self.db.save(values, getattr(self, "device_id", None))
            self.result = True
            self.destroy()
        except sqlite3.Error as exc:
            messagebox.showerror("Could not save", str(exc), parent=self)


class LinkDialog(tk.Toplevel):
    def __init__(self, parent, db, link=None):
        super().__init__(parent)
        apply_app_icon(self)
        self.db = db
        self.link_id = link["id"] if link else None
        self.result = False
        self.title("Edit device connection" if link else "Add device connection")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        devices = list(db.conn.execute("SELECT id, ip_address, hostname, device_type, organization FROM devices ORDER BY organization COLLATE NOCASE, ip_address"))
        self.labels = {
            f"{r['organization'].strip() or 'Unassigned'}  ·  {r['hostname'] or r['device_type'] or 'Unnamed device'}  ·  {format_ip_address(r['ip_address'])}  [#{r['id']}]": r['id']
            for r in devices
        }
        self.labels_by_id = {device_id: display for display, device_id in self.labels.items()}
        box = ttk.Frame(self, padding=20)
        box.pack(fill="both", expand=True)
        title = "Edit device connection" if link else "Connect two registered devices"
        ttk.Label(box, text=title, style="Title.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 14))
        ttk.Label(box, text="Device 1").grid(row=1, column=0, sticky="w", pady=6)
        ttk.Label(box, text="Device 2").grid(row=2, column=0, sticky="w", pady=6)
        self.source = ttk.Combobox(box, values=list(self.labels), state="readonly", width=62)
        self.target = ttk.Combobox(box, values=list(self.labels), state="readonly", width=62)
        self.source.grid(row=1, column=1, sticky="ew", padx=(12, 0), pady=6)
        self.target.grid(row=2, column=1, sticky="ew", padx=(12, 0), pady=6)
        if devices:
            self.source.current(0)
        if len(devices) > 1:
            self.target.current(1)
        if link:
            self.source.set(self.labels_by_id.get(link["source_id"], ""))
            self.target.set(self.labels_by_id.get(link["target_id"], ""))
        ttk.Label(box, text="Endpoints may belong to different organizations.", style="Sub.TLabel").grid(row=3, column=0, columnspan=2, sticky="w", pady=(4, 6))
        ttk.Label(box, text="Connection label").grid(row=4, column=0, sticky="w", pady=6)
        self.label = tk.StringVar(value=link["label"] if link else "Connected")
        ttk.Entry(box, textvariable=self.label, width=50).grid(row=4, column=1, sticky="ew", padx=(12, 0), pady=6)
        actions = ttk.Frame(box)
        actions.grid(row=5, column=0, columnspan=2, sticky="e", pady=(14, 0))
        ttk.Button(actions, text="Cancel", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(actions, text="Save changes" if link else "Save connection", style="Accent.TButton", command=self.save).pack(side="right")

    def save(self):
        source = self.labels.get(self.source.get())
        target = self.labels.get(self.target.get())
        label = self.label.get().strip() or "Connected"
        if source is None or target is None:
            messagebox.showerror("Choose devices", "Select two registered devices.", parent=self)
            return
        if source == target:
            messagebox.showerror("Choose two devices", "A device cannot be connected to itself.", parent=self)
            return
        try:
            if self.link_id is None:
                self.db.conn.execute("INSERT OR IGNORE INTO device_links(source_id,target_id,label) VALUES (?,?,?)", (source, target, label))
            else:
                self.db.conn.execute("UPDATE device_links SET source_id=?, target_id=?, label=? WHERE id=?", (source, target, label, self.link_id))
            self.db.conn.commit()
            self.result = True
            self.destroy()
        except sqlite3.Error as exc:
            messagebox.showerror("Could not save connection", str(exc), parent=self)

class ConnectionTreeWindow(tk.Toplevel):
    def __init__(self, parent, db):
        super().__init__(parent)
        apply_app_icon(self)
        self.db = db
        self.title("Connection Tree")
        self.geometry("1020x720")
        self.minsize(760, 520)
        self.transient(parent)
        self.configure(bg=getattr(parent, "colors", {}).get("window", "#edf2fa"))
        shell = ttk.Frame(self, padding=18)
        shell.pack(fill="both", expand=True)
        top = ttk.Frame(shell)
        top.pack(fill="x", pady=(0, 10))
        ttk.Label(top, text="Connection Tree", style="Title.TLabel").pack(side="left")
        ttk.Button(top, text="Remove selected", command=self.remove_link).pack(side="right", padx=(8, 0))
        ttk.Button(top, text="Edit selected", command=self.edit_link).pack(side="right", padx=(8, 0))
        ttk.Button(top, text="+ Add connection", style="Accent.TButton", command=self.add_link).pack(side="right")
        ttk.Label(shell, text="Only saved direct connections are drawn. With partner organizations included, only links involving the selected organization appear.", style="Sub.TLabel").pack(anchor="w", pady=(0, 8))
        filter_row = ttk.Frame(shell)
        filter_row.pack(fill="x", pady=(0, 10))
        ttk.Label(filter_row, text="Organization", style="FilterLabel.TLabel").pack(side="left", padx=(0, 8))
        self.organization_filter = tk.StringVar(value="All organizations")
        self.organization_combo = ttk.Combobox(filter_row, textvariable=self.organization_filter, state="readonly", width=30)
        self.organization_combo.pack(side="left")
        self.organization_combo.bind("<<ComboboxSelected>>", lambda _event: self.refresh())
        self.include_partner_orgs = tk.BooleanVar(value=False)
        ttk.Checkbutton(filter_row, text="Include partner organizations and show their direct links to this one", variable=self.include_partner_orgs, style="OrgFilter.TCheckbutton", command=self.refresh).pack(side="left", padx=(14, 0))

        chart = ttk.Frame(shell, style="Card.TFrame")
        chart.pack(fill="both", expand=True, pady=(0, 10))
        self.canvas = tk.Canvas(chart, bg="#ffffff", highlightthickness=0, height=400)
        ybar = ttk.Scrollbar(chart, orient="vertical", command=self.canvas.yview)
        xbar = ttk.Scrollbar(chart, orient="horizontal", command=self.canvas.xview)
        self.canvas.configure(yscrollcommand=ybar.set, xscrollcommand=xbar.set)
        self.canvas.grid(row=0, column=0, sticky="nsew")
        ybar.grid(row=0, column=1, sticky="ns")
        xbar.grid(row=1, column=0, sticky="ew")
        chart.rowconfigure(0, weight=1)
        chart.columnconfigure(0, weight=1)
        lower = ttk.Frame(shell, style="Card.TFrame", padding=10)
        lower.pack(fill="x")
        link_table = ttk.Frame(lower)
        link_table.pack(side="left", fill="both", expand=True)
        self.links = ttk.Treeview(link_table, columns=("source", "target", "label"), show="headings", height=5)
        for key, caption, width in (("source", "Device 1 · Name / IP", 340), ("target", "Device 2 · Name / IP", 340), ("label", "Connection label", 180)):
            self.links.heading(key, text=caption)
            self.links.column(key, width=width, minwidth=150, anchor="w", stretch=False)
        self.links.pack(fill="both", expand=True)
        links_hbar = ttk.Scrollbar(link_table, orient="horizontal", command=self.links.xview)
        self.links.configure(xscrollcommand=links_hbar.set)
        links_hbar.pack(fill="x")
        self._update_organization_filter()
        self.apply_theme()

    def _update_organization_filter(self):
        rows = self.db.conn.execute("SELECT organization FROM devices ORDER BY organization COLLATE NOCASE").fetchall()
        organizations = []
        seen = set()
        has_unassigned = False
        for row in rows:
            name = (row["organization"] or "").strip()
            if not name:
                has_unassigned = True
            elif name.casefold() not in seen:
                organizations.append(name)
                seen.add(name.casefold())
        values = ["All organizations"]
        if has_unassigned:
            values.append("Unassigned")
        values.extend(organizations)
        current = self.organization_filter.get()
        self.organization_combo.configure(values=values)
        if current not in values:
            self.organization_filter.set("All organizations")

    def apply_theme(self):
        dark = getattr(self.master, "theme_preference", tk.StringVar(value="Light")).get() == "Dark"
        self.map_colors = ({
            "background": "#0e1d34", "empty": "#a6b8d4", "link": "#789bd6",
            "label": "#8fb5ff", "node": "#192f50", "outline": "#70a1ff",
            "address": "#f0f5ff", "detail": "#b2c2dc",
        } if dark else {
            "background": "#ffffff", "empty": "#64748b", "link": "#7b9bdd",
            "label": "#174ab2", "node": "#edf3ff", "outline": "#174ab2",
            "address": "#14213d", "detail": "#52627a",
        })
        self.configure(bg=getattr(self.master, "colors", {}).get("window", "#edf2fa"))
        self.canvas.configure(bg=self.map_colors["background"])
        self.refresh()

    def add_link(self):
        devices = self.db.conn.execute("SELECT COUNT(*) FROM devices").fetchone()[0]
        if devices < 2:
            messagebox.showinfo("Add more devices", "Register at least two devices before creating a connection.", parent=self)
            return
        dialog = LinkDialog(self, self.db)
        self.wait_window(dialog)
        if dialog.result:
            self.refresh()
            self.master.persist_active_file()
            self.master.refresh_overview()

    def edit_link(self):
        selected = self.links.selection()
        if not selected:
            messagebox.showinfo("Select a connection", "Select a connection row first.", parent=self)
            return
        link = self.db.conn.execute("SELECT * FROM device_links WHERE id=?", (int(selected[0]),)).fetchone()
        dialog = LinkDialog(self, self.db, link)
        self.wait_window(dialog)
        if dialog.result:
            self.refresh()
            self.master.persist_active_file()
            self.master.refresh_overview()

    def remove_link(self):
        selected = self.links.selection()
        if not selected:
            messagebox.showinfo("Select a connection", "Select a connection row first.", parent=self)
            return
        self.db.conn.execute("DELETE FROM device_links WHERE id=?", (int(selected[0]),))
        self.db.conn.commit()
        self.refresh()
        self.master.persist_active_file()
        self.master.refresh_overview()

    def refresh(self):
        self._update_organization_filter()
        all_devices = list(self.db.conn.execute("SELECT id, ip_address, hostname, device_type, organization FROM devices ORDER BY organization COLLATE NOCASE, ip_address"))
        # Lines are sourced only from explicitly saved device_links records. Organizations
        # and filter membership never create inferred or all-to-all connections.
        all_links = list(self.db.conn.execute("SELECT l.id, l.source_id, l.target_id, l.label, a.ip_address AS source_ip, a.hostname AS source_host, a.organization AS source_org, b.ip_address AS target_ip, b.hostname AS target_host, b.organization AS target_org FROM device_links l JOIN devices a ON a.id=l.source_id JOIN devices b ON b.id=l.target_id ORDER BY l.id"))
        selected_org = self.organization_filter.get()
        if selected_org == "All organizations":
            visible_devices = all_devices
        else:
            selected_key = "" if selected_org == "Unassigned" else selected_org.strip().casefold()
            allowed_orgs = {selected_key}
            if self.include_partner_orgs.get():
                for link in all_links:
                    source_org = (link["source_org"] or "").strip().casefold()
                    target_org = (link["target_org"] or "").strip().casefold()
                    if source_org == selected_key:
                        allowed_orgs.add(target_org)
                    if target_org == selected_key:
                        allowed_orgs.add(source_org)
            visible_devices = [device for device in all_devices
                               if (device["organization"] or "").strip().casefold() in allowed_orgs]

        visible_ids = {device["id"] for device in visible_devices}
        links = [link for link in all_links
                 if link["source_id"] in visible_ids and link["target_id"] in visible_ids]
        if selected_org != "All organizations" and self.include_partner_orgs.get():
            # Partner devices provide context, but only explicit edges that touch the
            # selected organization belong in this filtered view. Do not show links
            # solely between two devices in a partner organization.
            links = [link for link in links
                     if (link["source_org"] or "").strip().casefold() == selected_key
                     or (link["target_org"] or "").strip().casefold() == selected_key]
        self.links.delete(*self.links.get_children())
        for link in links:
            source_ip = format_ip_address(link["source_ip"])
            target_ip = format_ip_address(link["target_ip"])
            source_name = link["source_host"] or "Unnamed device"
            target_name = link["target_host"] or "Unnamed device"
            left = f"{link['source_org'].strip() or 'Unassigned'} · {source_name} · {source_ip}"
            right = f"{link['target_org'].strip() or 'Unassigned'} · {target_name} · {target_ip}"
            self.links.insert("", "end", iid=str(link["id"]), values=(left, right, link["label"]))

        self.canvas.delete("all")
        if not visible_devices:
            prompt = "No devices match this organization filter." if all_devices else "No devices yet. Add devices to start your connection map."
            self.canvas.create_text(30, 35, anchor="nw", text=prompt, fill=self.map_colors["empty"], font=("Segoe UI", 11))
            self.canvas.configure(scrollregion=(0, 0, 600, 180))
            return
        display_addresses = {device["id"]: format_ip_address(device["ip_address"]) for device in visible_devices}
        longest_address = max(len(value) for value in display_addresses.values())
        node_width = max(210, min(380, longest_address * 8 + 54))
        cols = 4
        col_step = node_width + 65
        row_step = 175
        left_margin = 45
        positions = {}
        for index, device in enumerate(visible_devices):
            x = left_margin + node_width / 2 + (index % cols) * col_step
            y = 105 + (index // cols) * row_step
            positions[device["id"]] = (x, y)
        column_count = min(cols, len(visible_devices))
        row_count = (len(visible_devices) + cols - 1) // cols
        width = int(left_margin * 2 + column_count * node_width + max(0, column_count - 1) * 65)
        height = max(320, 155 + row_count * row_step)
        routed_lane_counts = {}
        device_by_id = {device["id"]: device for device in visible_devices}
        for link in links:
            x1, y1 = positions[link["source_id"]]
            x2, y2 = positions[link["target_id"]]
            # If a same-row edge would pass behind another device, route it below
            # that row so the unrelated device cannot look like an endpoint.
            blocked = y1 == y2 and any(
                device["id"] not in (link["source_id"], link["target_id"])
                and positions[device["id"]][1] == y1
                and min(x1, x2) < positions[device["id"]][0] < max(x1, x2)
                for device in visible_devices
            )
            if blocked:
                row_index = int((y1 - 105) // row_step)
                lane_index = routed_lane_counts.get(row_index, 0)
                routed_lane_counts[row_index] = lane_index + 1
                lane_y = y1 + 68 + lane_index * 14
                self.canvas.create_line(
                    x1, y1 + 52, x1, lane_y, x2, lane_y, x2, y2 + 52,
                    fill=self.map_colors["link"], width=2, arrow="last", joinstyle="round",
                )
                self.canvas.create_text((x1+x2)/2, lane_y - 10, text=link["label"], fill=self.map_colors["label"], font=("Segoe UI", 8, "bold"), tags=("edge_label",))
                height = max(height, int(lane_y + 42))
            else:
                self.canvas.create_line(x1, y1, x2, y2, fill=self.map_colors["link"], width=2, arrow="last")
                self.canvas.create_text((x1+x2)/2, (y1+y2)/2 - 10, text=link["label"], fill=self.map_colors["label"], font=("Segoe UI", 8, "bold"), tags=("edge_label",))
        for device in visible_devices:
            x, y = positions[device["id"]]
            self.canvas.create_rectangle(x-node_width/2, y-52, x+node_width/2, y+52, fill=self.map_colors["node"], outline=self.map_colors["outline"], width=2)
            self.canvas.create_text(x, y-27, text=display_addresses[device["id"]], fill=self.map_colors["address"], font=("Segoe UI", 10, "bold"), width=node_width-24, justify="center")
            detail = device["hostname"] or device["device_type"] or "Device"
            self.canvas.create_text(x, y-3, text=detail[:34], fill=self.map_colors["detail"], font=("Segoe UI", 8), width=node_width-24, justify="center")
            organization = (device["organization"] or "Unassigned").strip() or "Unassigned"
            self.canvas.create_text(x, y+23, text=organization[:42], fill=self.map_colors["label"], font=("Segoe UI", 8, "bold"), width=node_width-24, justify="center")
        self.canvas.configure(scrollregion=(0, 0, width, height))

class AssetInventoryApp(tk.Tk):
    COLUMNS = [("ip_address", "Host / IP", 150), ("device_type", "Device type", 125),
               ("hostname", "Preferred hostname", 180), ("organization", "Organization", 155),
               ("connection", "Connection", 110), ("user_type", "User type", 120)]

    def __init__(self):
        super().__init__()
        apply_app_icon(self)
        self.db = InventoryDB()
        self.active_inventory_file = None
        self.dirty = False
        self.title("Asset Inventory")
        self.geometry("1240x760")
        self.minsize(960, 600)
        self.configure(bg="#0a1428")
        self.selected_id = None
        self.theme_preference = tk.StringVar(value="Light")
        self.font_preference = tk.StringVar(value="Medium")
        self._style()
        self._layout()
        self.refresh()
        self.protocol("WM_DELETE_WINDOW", self.on_close)
        self.deiconify()

    def has_unsaved_entries(self):
        # Without an active file, only a non-default in-memory inventory is unsaved work.
        # This clears naturally after users undo their changes (for example, add then delete).
        device_count = self.db.conn.execute("SELECT COUNT(*) FROM devices").fetchone()[0]
        link_count = self.db.conn.execute("SELECT COUNT(*) FROM device_links").fetchone()[0]
        if device_count or link_count:
            return True
        return any(set(self.db.choices(category)) != set(defaults)
                   for category, defaults in DEFAULTS.items())

    def persist_active_file(self):
        if not self.active_inventory_file:
            self.dirty = self.has_unsaved_entries()
            return
        try:
            self.db.export_file(self.active_inventory_file)
            self.dirty = False
        except OSError as exc:
            self.dirty = True
            messagebox.showerror("Could not save inventory file", str(exc), parent=self)

    def _remember_active_file(self):
        # File selection is deliberately session-only. The user chooses a file again through Import, Export, or Change file.
        self.dirty = False

    def on_close(self):
        if not self.dirty:
            self.destroy()
            return
        if self.active_inventory_file:
            prompt = "Changes could not be saved to the selected file. Are you sure you want to quit?"
        else:
            prompt = "Your progress has not been saved to a file. Are you sure you want to quit? Choose No to return and export your work."
        if messagebox.askyesno("Unsaved progress", prompt, parent=self):
            self.destroy()
    def report_callback_exception(self, exc_type, exc_value, exc_traceback):
        messagebox.showerror(
            "Unexpected app error",
            f"Something went wrong. Please review your inventory and save a copy if needed.\\n\\nDetails: {exc_value}",
            parent=self,
        )
    def change_inventory_file(self):
        current = self.active_inventory_file
        chosen = filedialog.asksaveasfilename(parent=self, title="Choose inventory file", defaultextension=".json", filetypes=[("Asset Inventory JSON", "*.json")], initialdir=str(current.parent) if current else str(Path.home()), initialfile=current.name if current else "asset-inventory.json")
        if not chosen:
            return
        path = Path(chosen)
        try:
            if path.resolve() != current.resolve() if current else True:
                if path.exists():
                    if not messagebox.askyesno("Load another inventory?", "This file will replace the inventory currently open in the app. Continue?", parent=self):
                        return
                    self.db.import_file(path)
                else:
                    self.db.export_file(path)
            self.active_inventory_file = path
            self._remember_active_file()
            self.clear_filters()
            self.refresh()
        except (OSError, json.JSONDecodeError, ValueError, sqlite3.Error) as exc:
            messagebox.showerror("Could not change inventory file", str(exc), parent=self)

